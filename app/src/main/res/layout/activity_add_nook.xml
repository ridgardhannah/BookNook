<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!--space for toolbar with back arrow-->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBackBtn"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Add New Nook" />

    <!--everything from this point can be scrolled-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnSubmitNook"
        app:layout_constraintTop_toBottomOf="@id/toolbarBackBtn">

        <!--everything between scrollbar and the submit button-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!--mini map selection area. do logic later. should be able to move map to line up with pin-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <!--map goes in here -->
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/miniMap"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!--map pin icon. maybe sort logic later to have pin colour vary according to nook type? problem for later-->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_location_pin"
                    app:tint="?attr/colorError" />
            </com.google.android.material.card.MaterialCardView>

            <!--user input section-->
            <!-- type in name-->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Nook Name"
                app:placeholderText="Enter Nook Name here...">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNookName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--drop down options for nook type. -->
            <!--type ideas: little free library(branding legal stuff tho?), converted phone box, community bookcase (options for pub/cafe/supermarket), council-owned library, outdoor reading spot, indoor reading spot-->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nook Type">
                <AutoCompleteTextView
                    android:id="@+id/nookType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Converted Phonebox" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- big box to write a description in -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Nook Description"
                app:placeholderText="This book nook is..."
                app:helperText="Tip: Describe the location and the types of books found here.">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Accessibility and Access"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWheelchair"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wheelchair Accessible"
                    app:chipIcon="@drawable/ic_wheelchair" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWellLit"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Well Lit Area"
                    app:chipIcon="@drawable/ic_lightbulb" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOpenAlways"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open 24/7"
                    app:chipIcon="@drawable/ic_clock" />

            </com.google.android.material.chip.ChipGroup>



        </LinearLayout><!--end on details linear layout-->
    </ScrollView> <!--end of scrolly bit-->

    <!-- submit button. find icon?-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitNook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Submit Nook"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>