<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReport"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Report Issue"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@id/btnSubmitReport"
        app:layout_constraintTop_toBottomOf="@id/toolbarReport">

        <!--prompt user-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What issue(s) would you like to report?"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <!--checkboxes -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbDamaged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Damaged / Vandalised" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbNotExist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nook doesn't exist" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbInappropriate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inappropriate content" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Other" />


        <!--text for add photo-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Add a photo (optional)"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llReportPhotoGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvAddReportPhoto"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/reportPhotoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>


        <!--text input for details -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Additional Details"
            app:helperText="Please describe the issue in detail.">
            <!--little helper instruction under the box-->

            <!--removed hardcoded text-->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!--submit button change ID 11-->
    <!--background tint gone. changed to primary colour instead-->
    <!--added icon and fixed gravity on it-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitReport"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Submit Report"
        app:icon="@drawable/ic_report"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>