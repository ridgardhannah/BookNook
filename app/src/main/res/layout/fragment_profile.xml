<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!--settings icon top right-->
    <ImageView
        android:id="@+id/ivSettings"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="24dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!--user avatar-->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="32dp"
        android:padding="4dp"
        android:src="@drawable/ic_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.ExtraLarge"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="2dp" />

    <!--name and rank-->
    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Alex Reader"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAvatar" />

    <TextView
        android:id="@+id/tvUserBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Scout"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserName" />

    <!--container to hold 3 stats boxes -->
    <LinearLayout
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvUserBadge">

        <include
            android:id="@+id/statNooks"
            layout="@layout/layout_stat_card"
            />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp"
            />

        <include
            android:id="@+id/statDonated"
            layout="@layout/layout_stat_card"
            />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp"
            />

        <include
            android:id="@+id/statFound"
            layout="@layout/layout_stat_card"
            />
    </LinearLayout>

    <!--tab layout. elastic-->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/profileTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/statsContainer"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/colorPrimary">

        <!-- changed tab name for change id 13-->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Activity" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievements" />
    </com.google.android.material.tabs.TabLayout>


    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileTabLayout">


        <!--My Activity. default visible-->
        <ListView
            android:id="@+id/lvProfileContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/colorOutlineVariant"
            android:dividerHeight="1dp" />

        <!--achievements. hidden by default-->
        <!--remember for later: ive set visibility to gone at first. java logic will toggle it -->
        <ScrollView
            android:id="@+id/achievementsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <!-- grid to fit hex's in-->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:rowCount="3">

                <!--helper layout for hex 1 booksworm achievement.-->
                <!--hardcoded for now-->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!--the hex-->
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/shape_hexagon"
                        app:tint="#D4AF37"
                        /> <!--coloured in for achieved-->

                    <!--label-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bookworm"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textStyle="bold" />
                </LinearLayout>

                <!--hex 2 is locked still-->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/shape_hexagon"
                        app:tint="?attr/colorOutlineVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Archivist"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textStyle="bold" />
                </LinearLayout>

                <!--hex 3 locked still-->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/shape_hexagon"
                        app:tint="?attr/colorOutlineVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scout"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textStyle="bold" />
                </LinearLayout>

                <!--do more rows later on-->

            </GridLayout><!--end of hex grid-->
        </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>