                        <TextView android:id="@+id/medal_2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Loading..." android:textColor="@color/black" android:textSize="10sp" android:textStyle="bold" />
                    </LinearLayout>
