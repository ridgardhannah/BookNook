<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!--settings icon top right-->
    <ImageView
        android:id="@+id/ivSettings"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="24dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!--user avatar-->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="32dp"
        android:padding="4dp"
        android:src="@drawable/ic_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.ExtraLarge"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="2dp" />

    <!--name and rank-->
    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Alex Reader"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivAvatar" />

    <TextView
        android:id="@+id/tvUserBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Scout"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserName" />

    <!--container to hold 3 stats boxes -->
    <LinearLayout
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvUserBadge">

        <include
            android:id="@+id/statNooks"
            layout="@layout/layout_stat_card" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <include
            android:id="@+id/statDonated"
            layout="@layout/layout_stat_card" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <include
            android:id="@+id/statFound"
            layout="@layout/layout_stat_card" />
    </LinearLayout>

    <!--tab layout. elastic-->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/profileTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/statsContainer"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/colorPrimary">

        <!-- changed tab name for change id 13-->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Activity" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievements" />
    </com.google.android.material.tabs.TabLayout>


    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileTabLayout">


        <!--My Activity. default visible-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lvProfileContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/colorOutlineVariant"
            android:dividerHeight="1dp" />

        <!--achievements. hidden by default-->
        <!--remember for later: ive set visibility to gone at first. java logic will toggle it -->
        <ScrollView
            android:id="@+id/achievementsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="40dp">

                <!--pinned to screen. main medal. all ofhters anchor to this -->
                <FrameLayout
                    android:id="@+id/medal_2"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!--hex-->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_gold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">

                        <!--icon-->
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_book"
                            app:tint="@color/black" />

                        <!--text inside medal-->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bookworm"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </FrameLayout>


                <!--topleft medal-->
                <FrameLayout
                    android:id="@+id/medal_1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:layout_constraintEnd_toStartOf="@+id/medal_2"
                    app:layout_constraintTop_toTopOf="@+id/medal_2">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_gold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!--change to 5 icon soon-->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reader"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- top right medal-->
                <FrameLayout
                    android:id="@+id/medal_3"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:layout_constraintStart_toEndOf="@+id/medal_2"
                    app:layout_constraintTop_toTopOf="@+id/medal_2">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_grey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30"
                            android:textColor="#888888"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Archivist"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!--row 2-->
                <!-- -ve margin to to fit in gaps-->
                <FrameLayout
                    android:id="@+id/medal_4"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintEnd_toEndOf="@+id/medal_2"
                    app:layout_constraintStart_toStartOf="@+id/medal_1"
                    app:layout_constraintTop_toBottomOf="@+id/medal_1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_grey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60"
                            android:textColor="#888888"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Legend"
                            android:textColor="#888888"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_5"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintEnd_toEndOf="@+id/medal_3"
                    app:layout_constraintStart_toStartOf="@+id/medal_2"
                    app:layout_constraintTop_toBottomOf="@+id/medal_2">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_gold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scout"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_6"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintEnd_toEndOf="@+id/medal_1"
                    app:layout_constraintStart_toStartOf="@+id/medal_1"
                    app:layout_constraintTop_toBottomOf="@+id/medal_4">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_grey" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Explorer"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_7"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintEnd_toEndOf="@+id/medal_2"
                    app:layout_constraintStart_toStartOf="@+id/medal_2"
                    app:layout_constraintTop_toBottomOf="@+id/medal_4">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Snapper"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_8"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintEnd_toEndOf="@+id/medal_3"
                    app:layout_constraintStart_toStartOf="@+id/medal_3"
                    app:layout_constraintTop_toBottomOf="@+id/medal_5">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shape_hexagon_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Hero"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_9"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintTop_toBottomOf="@+id/medal_6"
                    app:layout_constraintStart_toStartOf="@+id/medal_6"
                    app:layout_constraintEnd_toEndOf="@+id/medal_7">

                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shape_hexagon_grey" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="8dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_book" app:tint="#888888" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locked" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_10"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintTop_toBottomOf="@+id/medal_7"
                    app:layout_constraintStart_toStartOf="@+id/medal_7"
                    app:layout_constraintEnd_toEndOf="@+id/medal_8">

                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shape_hexagon_grey" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="8dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_book" app:tint="#888888" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locked" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_11"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintTop_toBottomOf="@+id/medal_9"
                    app:layout_constraintStart_toStartOf="@+id/medal_6"
                    app:layout_constraintEnd_toEndOf="@+id/medal_6">

                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shape_hexagon_grey" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="8dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_book" app:tint="#888888" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locked" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_12"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintTop_toBottomOf="@+id/medal_9"
                    app:layout_constraintStart_toStartOf="@+id/medal_7"
                    app:layout_constraintEnd_toEndOf="@+id/medal_7">

                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shape_hexagon_grey" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="8dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_book" app:tint="#888888" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locked" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/medal_13"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="-16dp"
                    app:layout_constraintTop_toBottomOf="@+id/medal_10"
                    app:layout_constraintStart_toStartOf="@+id/medal_8"
                    app:layout_constraintEnd_toEndOf="@+id/medal_8">

                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shape_hexagon_grey" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingBottom="8dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_book" app:tint="#888888" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locked" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>